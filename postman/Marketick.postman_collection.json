  "item": [
    {
      "name": "00 - Seed data verification",
      "description": "Confirms sample seed data is present via the candles API. Fails if you have not run jalali-seed and sample-seed.",
      "item": [
        {
          "name": "BTCUSDT daily candles (seeded gregorian)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/candles?symbol={{gregorian_symbol}}&timeframe=1d&from=2020-01-01&to=2020-01-31",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "candles"],
              "query": [
                {"key": "symbol", "value": "{{gregorian_symbol}}"},
                {"key": "timeframe", "value": "1d"},
                {"key": "from", "value": "2020-01-01"},
                {"key": "to", "value": "2020-01-31"}
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json().data;",
                  "pm.test('Symbol is BTCUSDT', () => pm.expect(body.symbol).to.eql('BTCUSDT'));",
                  "pm.test('Calendar is gregorian', () => pm.expect(body.calendar).to.eql('gregorian'));",
                  "pm.test('Has seeded candles', () => pm.expect(body.candles.length).to.be.above(0));",
                  "pm.test('Metadata present', () => {",
                  "  const m = pm.response.json().metadata;",
                  "  pm.expect(m.page).to.eql(1);",
                  "  pm.expect(m.limit).to.eql(1000);",
                  "  pm.expect(m).to.have.property('has_more');",
                  "  pm.expect(m.count).to.eql(body.candles.length);",
                  "});",
                  "pm.test('Candle has OHLCV fields', () => {",
                  "  const c = body.candles[0];",
                  "  pm.expect(c).to.have.property('open');",
                  "  pm.expect(c).to.have.property('high');",
                  "  pm.expect(c).to.have.property('low');",
                  "  pm.expect(c).to.have.property('close');",
                  "  pm.expect(c).to.have.property('volume');",
                  "  pm.expect(c).to.have.property('tick_count');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "USDIRR daily candles (seeded jalali)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/candles?symbol={{jalali_symbol}}&timeframe=1d&from=2000-01-01&to=2000-01-31",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "candles"],
              "query": [
                {"key": "symbol", "value": "{{jalali_symbol}}"},
                {"key": "timeframe", "value": "1d"},
                {"key": "from", "value": "2000-01-01"},
                {"key": "to", "value": "2000-01-31"}
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json().data;",
                  "pm.test('Symbol is USDIRR', () => pm.expect(body.symbol).to.eql('USDIRR'));",
                  "pm.test('Calendar is jalali', () => pm.expect(body.calendar).to.eql('jalali'));",
                  "pm.test('Has seeded candles', () => pm.expect(body.candles.length).to.be.above(0));",
                  "pm.test('Jalali fields present', () => {",
                  "  const c = body.candles[0];",
                  "  pm.expect(c).to.have.property('jalali_year');",
                  "  pm.expect(c).to.have.property('jalali_month');",
                  "  pm.expect(c).to.have.property('jalali_day');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
